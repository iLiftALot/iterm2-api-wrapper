# --- Module protocols for the lazily-resolved PyObjC framework modules ---
# Each lists exactly the attributes the runtime shim pulls from that module.

class ObjcModule(Protocol):
    autorelease_pool: type[autorelease_pool]

class FoundationModule(Protocol):
    NSDate: type[NSDate]
    NSDefaultRunLoopMode: Literal["kCFRunLoopDefaultMode"]
    NSURL: type[NSURL]
    NSAppleEventDescriptor: type[NSAppleEventDescriptor]
    NSAppleScript: type[NSAppleScript]
    NSRunLoop: type[NSRunLoop]
    NSRunLoopCommonModes: Literal["kCFRunLoopCommonModes"]
    NSPort: type[NSPort]
    NSTimer: type[NSTimer]
    NSBundle: type[NSBundle]

class AppKitModule(Protocol):
    NSWorkspace: type[NSWorkspace]
    NSWorkspaceOpenConfiguration: type[NSWorkspaceOpenConfiguration]
    NSRunningApplication: type[NSRunningApplication]
    NSApplicationActivateAllWindows: Literal[1]
    @property
    @deprecated("Use NSApplicationActivateAllWindows instead")
    def NSApplicationActivateIgnoringOtherApps(self) -> Literal[2]: ...
    NSWorkspaceLaunchAndPrint: Literal[2]
    NSWorkspaceLaunchWithErrorPresentation: Literal[64]
