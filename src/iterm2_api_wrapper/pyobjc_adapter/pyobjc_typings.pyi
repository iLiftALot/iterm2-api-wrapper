"""Type stubs for the untyped PyObjC symbols re-exported by ``pyobjc_typings.py``.

Type checkers prefer this ``.pyi`` over the runtime ``.py`` module, so the
classes/constants below describe only the surface this project uses. None of
this exists at runtime — the real objects come from PyObjC framework modules.
"""

from collections.abc import Callable, Mapping, Sequence
from types import TracebackType
from typing import Literal, Protocol, TypeAlias, TypedDict
from typing_extensions import deprecated

AXAction: TypeAlias = str
AXAttribute: TypeAlias = str
AXError: TypeAlias = int
AXRole: TypeAlias = str
FourCharCode: TypeAlias = int
NSComparisonResult: TypeAlias = Literal[-1, 0, 1]
NSRunLoopMode: TypeAlias = str
NSTimeInterval: TypeAlias = float
NSWorkspaceLaunchIdentifier: TypeAlias = int

class AXUIElement:
    """Opaque ``AXUIElementRef`` handle produced and consumed by the AX APIs."""

class CFRunLoop:
    """Opaque ``CFRunLoopRef`` handle returned by ``NSRunLoop.getCFRunLoop``."""

class ObjCSelector(Protocol):
    """PyObjC ``objc.selector`` wrapper (e.g. the return of ``endSheetMethod``)."""

    selector: bytes
    signature: bytes
    callable: Callable[..., object]

class NSRange(Protocol):
    location: int
    length: int

class NSValue(Protocol):
    def rangeValue(self) -> NSRange: ...

class NSData(Protocol):
    def length(self) -> int: ...
    def bytes(self) -> memoryview: ...

class NSLocale(Protocol):
    @classmethod
    def currentLocale(cls) -> NSLocale: ...
    def localeIdentifier(self) -> str: ...

class NSError(Protocol):
    def domain(self) -> str: ...
    def code(self) -> int: ...
    def localizedDescription(self) -> str: ...
    def localizedFailureReason(self) -> str | None: ...
    def localizedRecoverySuggestion(self) -> str | None: ...
    def userInfo(self) -> Mapping[str, object]: ...

class NSAppleEventError(TypedDict, total=False):
    """Error dictionary produced by ``NSAppleScript`` compile/execute failures."""

    NSAppleScriptErrorMessage: str
    NSAppleScriptErrorBriefMessage: str
    NSAppleScriptErrorNumber: int
    NSAppleScriptErrorAppName: str
    NSAppleScriptErrorRange: NSValue

class NSWorkspaceApplicationInfo(TypedDict, total=False):
    """Entries of ``NSWorkspace.activeApplication``/``launchedApplications``."""

    NSApplicationBundleIdentifier: str
    NSApplicationName: str
    NSApplicationPath: str
    NSApplicationProcessIdentifier: int
    NSApplicationProcessSerialNumberHigh: int
    NSApplicationProcessSerialNumberLow: int
    NSWorkspaceApplicationKey: NSRunningApplication

class UTType(Protocol):
    """UniformTypeIdentifiers ``UTType`` (content-type descriptor)."""

    @classmethod
    def typeWithIdentifier_(cls, identifier: str) -> UTType | None: ...
    @classmethod
    def typeWithFilenameExtension_(cls, filename_extension: str) -> UTType | None: ...
    @classmethod
    def typeWithMIMEType_(cls, mime_type: str) -> UTType | None: ...
    def identifier(self) -> str: ...
    def preferredFilenameExtension(self) -> str | None: ...
    def preferredMIMEType(self) -> str | None: ...
    def localizedDescription(self) -> str | None: ...
    def isDynamic(self) -> bool: ...
    def isDeclared(self) -> bool: ...
    def isPublicType(self) -> bool: ...
    def conformsToType_(self, other: UTType) -> bool: ...

# PyObjC framework modules re-exported by the runtime shim. They resolve their
# attributes dynamically via module-level ``__getattr__``; the module protocols
# (defined at the bottom of this stub) describe the exact surface pulled from
# each of them.
AppKit: AppKitModule
ApplicationServices: ApplicationServicesModule
Foundation: FoundationModule
AppHelper: AppHelperModule
objc: ObjcModule

# --- objc classes/functions ---
