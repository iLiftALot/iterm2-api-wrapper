TRAPUSR1() {
    local target signal_file
    signal_file=~/.iterm2/api-wrapper/signals/.iterm2_cd_target.$$
    target=$(<"$signal_file") 2>/dev/null
    [[ -d $target ]] && cd -- "$target"
    rm -f -- "$signal_file"
    if zle; then
        local f
        for f in $precmd_functions; do $f; done
        zle reset-prompt
    fi
}
