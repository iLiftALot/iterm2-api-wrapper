{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Script",
      "type": "shell",
      "command": "osascript",
      "args": [
        "${cwd}/src/iterm2_api_wrapper/mac/applescripts/iterm_osa.scpt",
        "true",
        "${cwd}/src/iterm2_api_wrapper/mac/applescripts"
      ],
      "dependsOn": "Compile Script",
      "problemMatcher": []
    },
    {
      "label": "Compile Script",
      "type": "shell",
      "command": "${cwd}/scripts/osacompiler",
      "group": "build",
      "problemMatcher": {
        "owner": "applescript",
        "source": "osacompile",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^(.*\\.applescript):(\\d+):(\\d+):\\s*(?:script )?error:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Copilot: Profile precedence regression",
      "type": "shell",
      "command": "env",
      "args": [
        "IT2_PYTEST_INTEGRATION=0",
        "IT2_DEFAULT_PROFILE=iterm2-api-test",
        "uv", "run", "--python=3.11", "--group", "dev", "pytest",
        "--maxfail=0", "-q"
      ],
      "problemMatcher": []
    },
    {
      "label": "Copilot: Profile lint",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--python=3.11", "--group", "dev", "--group", "ci", "ruff", "check", "."],
      "problemMatcher": []
    },
    {
      "label": "Copilot: Profile format",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--python=3.11", "--group", "dev", "--group", "ci", "ruff", "format", "--check", "."],
      "problemMatcher": []
    }
  ]
}



